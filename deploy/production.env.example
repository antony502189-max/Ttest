# Copy this file to /srv/112233.es/shared/production.env on the VPS, then chmod 600 it.
# Do not commit the copied file. Generate JWT_SECRET, EMAIL_VERIFICATION_HMAC_SECRET,
# POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD and S3_SECRET_KEY independently with a
# cryptographic generator.
APP_DOMAIN=app.112233.es
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
POSTGRES_DB=ttest
POSTGRES_USER=ttest
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
EMAIL_VERIFICATION_HMAC_SECRET=REPLACE_WITH_A_DIFFERENT_32_PLUS_RANDOM_SECRET
DATABASE_URL=postgresql+asyncpg://ttest:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/ttest
# These shared values cap each backend/worker process. With three processes the
# worst-case database usage is (pool + overflow) * 3.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=ttest-minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_SECRET
S3_BUCKET=ttest-media
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ttest-app
S3_SECRET_KEY=REPLACE_WITH_STRONG_SECRET
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
S3_MAX_ATTEMPTS=3
S3_MAX_POOL_CONNECTIONS=32
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION=8000
MAX_IMAGE_PIXELS=25000000
IMAGE_PROCESSING_CONCURRENCY=2
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_STRONG_SECRET
# Gmail example: smtp.gmail.com / 587 / Gmail address / Google App Password.
# SMTP_FROM must be the authenticated Gmail address or a verified Gmail alias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=112233.es
SMTP_STARTTLS=true
GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_GOOGLE_CLIENT_ID=
EXTERNAL_WORKER_STALE_AFTER_SECONDS=300
