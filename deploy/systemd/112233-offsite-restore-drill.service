[Unit]
Description=112233.es off-site backup restore verification drill
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/srv/112233.es/current/deploy/offsite-restore-drill.sh
TimeoutStartSec=10800
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/112233.es/backups /srv/112233.es/shared
