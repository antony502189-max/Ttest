FROM busybox:1.37.0-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23 AS downloader

ARG TARGETARCH
ARG MINIO_RELEASE=RELEASE.2025-04-22T22-12-26Z

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) minio_sha256="53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c" ;; \
      arm64) minio_sha256="6c2f3142c94240206123177f4ba1e360daa5d1e0a4962e90757ef4f92c3ab57c" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 64 ;; \
    esac; \
    wget -q -O /minio "https://github.com/minio/minio/releases/download/$MINIO_RELEASE/minio.linux-$TARGETARCH.$MINIO_RELEASE"; \
    echo "$minio_sha256  /minio" | sha256sum -c -; \
    chmod 0755 /minio

FROM busybox:1.37.0-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23

COPY --from=downloader /minio /usr/bin/minio
RUN mkdir -p /data

ENTRYPOINT ["minio"]
