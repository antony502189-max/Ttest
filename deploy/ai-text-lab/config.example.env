# Review example only. The launcher uses the exact same values from compose.yml.
# No real secrets. Do not source into an application/staging/production service.
APP_ENV=test
AI_SYNTHETIC_LAB=ttest-ai-text-lab.synthetic.v1
DATABASE_URL=postgresql+asyncpg://ai_lab:synthetic-local-only@postgres:5432/ai_text_lab
REDIS_URL=redis://redis:6379/0
FRONTEND_APP_URL=https://localhost:9443
FRONTEND_ORIGINS=https://localhost:9443
EXTERNAL_IMPORT_ENABLED=false
EXTERNAL_REMOVAL_CHECK_ENABLED=false
JWT_SECRET=synthetic-lab-auth-independent-key-only-v1
# Guest/cursor keys are separate synthetic constants in backend/lab/ai_text.py.
# Runtime is selected ONLY by uvicorn lab.ai_text:create_app --factory.
