FROM busybox:1.37.0-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23 AS downloader

ARG TARGETARCH
ARG MC_RELEASE=RELEASE.2025-04-16T18-13-26Z

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) mc_sha256="ac90da87a35641be5a0ac75d49de5161ddb47d629b5ba01261b0ae9e00aea15f" ;; \
      arm64) mc_sha256="61bb88e7435919834478ddd4d405a6de6d2c227079da5e8ee9655147398819a0" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 64 ;; \
    esac; \
    wget -q -O /mc "https://github.com/minio/mc/releases/download/$MC_RELEASE/mc.linux-$TARGETARCH.$MC_RELEASE"; \
    echo "$mc_sha256  /mc" | sha256sum -c -; \
    chmod 0755 /mc

FROM busybox:1.37.0-musl@sha256:fc6dddc4c44b1bfe37f41cae8e67d1693828e8f42a91862816d7953e2c9d3f23

COPY --from=downloader /mc /usr/bin/mc

ENTRYPOINT ["mc"]
