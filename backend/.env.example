APP_ENV=development
APP_NAME=112233-api
DATABASE_URL=postgresql+asyncpg://ttest:ttest@localhost:5432/ttest
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_MINUTES=1440

GOOGLE_CLIENT_ID=
FRONTEND_APP_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4174,https://antony502189-max.github.io

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@112233.es
SMTP_STARTTLS=true
MAIL_WORKER_INTERVAL_SECONDS=10
MAIL_WORKER_BATCH_SIZE=50
MAIL_MAX_ATTEMPTS=8

AUTO_PUBLISH_LISTINGS=false
MEDIA_ROOT=./var/media
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION=8000
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

REDIS_URL=
METRICS_ENABLED=true
STRUCTURED_LOGS=true
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

EXTERNAL_IMPORT_ENABLED=1
EXTERNAL_IMPORT_INTERVAL_SECONDS=7200
EXTERNAL_IMPORT_RUN_ON_START=1
EXTERNAL_IMPORT_SOURCES=idealista,fotocasa,milanuncios,pisocompartido
EXTERNAL_IMPORT_REQUEST_TIMEOUT_SECONDS=25
EXTERNAL_IMPORT_MAX_CONCURRENCY_PER_SOURCE=3
EXTERNAL_IMPORT_DOWNLOAD_IMAGES=1
EXTERNAL_IMPORT_USER_AGENT=112233.es room aggregator
EXTERNAL_IMPORT_PLAYWRIGHT_ENABLED=1

# Production checklist:
# - APP_ENV=production
# - HTTPS frontend/API origins only
# - strong unique JWT_SECRET
# - managed PostgreSQL with PostGIS and automated backups
# - Redis configured for distributed rate limits
# - S3-compatible storage credentials configured
# - SMTP configured and outbox worker running
# - Google OAuth client restricted to the production domains
# - SENTRY_DSN or another production error tracker configured
